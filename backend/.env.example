DATABASE_URL=postgresql://studypair:studypair@localhost:5433/studypair
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a real secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=changeme
# Generate a separate real secret the same way — keep this different from
# JWT_SECRET. Only signs the OAuth handshake cookie.
SESSION_SECRET=changeme-too

# Where the React app runs. Must match a redirect URI you've registered in
# Google Cloud Console (Authorized redirect URIs -> this backend's
# /auth/google/callback, NOT this URL directly).
FRONTEND_URL=http://localhost:5173

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt PII columns (currently: phone_number) at rest.
FIELD_ENCRYPTION_KEY=
